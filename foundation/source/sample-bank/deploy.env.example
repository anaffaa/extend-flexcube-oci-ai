# Copy to deploy.env and edit. Used by deploy_sample_source.sh (sample bank) and deploy_serving_layer.sh.
# Never put passwords in this file: the scripts read them from OCI Vault or ask for them.

# Deployed the Terraform foundation? Set FROM_TERRAFORM=true and the compartment, bucket, database and
# password secrets are read from its outputs (TF_DIR defaults to foundation/terraform). The rest is then ignored.
FROM_TERRAFORM=false
TF_DIR=

# OCI CLI profile (from ~/.oci/config) and target compartment
OCI_PROFILE=DEFAULT
COMPARTMENT_OCID=ocid1.compartment.oc1..replace_me

# Object Storage bucket that stages the sample files (created if missing, private)
BUCKET_NAME=fcubs-demo-data

# Optional: OCI Vault secret OCIDs holding the passwords (otherwise prompted)
ADMIN_SECRET_OCID=
READER_SECRET_OCID=

# Autonomous AI Database for the sample FLEXCUBE source.
# Leave ADB_OCID empty to create a new one called ADB_NAME; set it to reuse an existing database.
ADB_OCID=
ADB_NAME=FCUBSDEMO
ADB_ECPU=2
ADB_STORAGE_GB=20

# Sample data: use the prebuilt files in data/ (REGENERATE=false), or regenerate them first.
# Regenerating takes a few minutes and keeps the planted scenarios; CUSTOMERS changes the bank size.
REGENERATE=false
CUSTOMERS=2000
